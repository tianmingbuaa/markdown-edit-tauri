{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mojian",
  "version": "0.1.1",
  "identifier": "com.mojian.markdown",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "墨笺 · Markdown",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "decorations": false,
        "backgroundColor": "#f7f4ee"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A calm, autosaving Markdown workspace.",
    "longDescription": "墨笺 is a focused desktop Markdown editor. Open a folder as your library, pick a note and write — every change saves itself.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
